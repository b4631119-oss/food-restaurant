rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'suhibarno1@gmail.com';
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }
    function counterPath() {
      return /databases/$(database)/documents/counters/orders;
    }
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'items', 'total', 'type', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.type in ['delivery', 'pickup']
        && request.resource.data.status == 'new'
        && request.resource.data.number is int
        && getAfter(counterPath()).data.orderId == orderId
        && getAfter(counterPath()).data.value == request.resource.data.number
        && request.resource.data.keys().hasOnly(['name', 'phone', 'items', 'total', 'type', 'status', 'address', 'comment', 'createdAt', 'number', 'source']);
    }
    match /counters/orders {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['value', 'orderId'])
        && request.resource.data.value == 1001
        && request.resource.data.orderId is string
        && !exists(orderPath(request.resource.data.orderId))
        && getAfter(orderPath(request.resource.data.orderId)).data.number == request.resource.data.value
        && getAfter(orderPath(request.resource.data.orderId)).data.status == 'new';
      allow update: if request.resource.data.keys().hasOnly(['value', 'orderId'])
        && request.resource.data.value == resource.data.value + 1
        && request.resource.data.orderId is string
        && !exists(orderPath(request.resource.data.orderId))
        && getAfter(orderPath(request.resource.data.orderId)).data.number == request.resource.data.value
        && getAfter(orderPath(request.resource.data.orderId)).data.status == 'new';
    }
  }
}
