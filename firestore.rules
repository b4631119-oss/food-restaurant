rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Админ — только владелец документа admins/{uid}, созданного вручную в Firebase Console.
    // Почта в правилах не участвует: смена email не выдаёт и не отнимает доступ.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function productPath(productId) { return /databases/$(database)/documents/products/$(productId); }
    function orderPath(orderId) { return /databases/$(database)/documents/orders/$(orderId); }
    function counterPath() { return /databases/$(database)/documents/counters/orders; }
    // Отсутствующее необязательное поле допустимо, присутствующее — строка в лимитах.
    function optionalString(key, maxSize) {
      return !(key in request.resource.data)
        || (request.resource.data[key] is string && request.resource.data[key].size() <= maxSize);
    }
    function requiredString(key, minSize, maxSize) {
      return request.resource.data[key] is string && request.resource.data[key].size() >= minSize
        && request.resource.data[key].size() <= maxSize;
    }
    function validSource() {
      return !('source' in request.resource.data) || request.resource.data.source in ['website', 'demo'];
    }
    function validCreatedAt() {
      return !('createdAt' in request.resource.data) || request.resource.data.createdAt is string;
    }
    // Публичное создание заказа: без items/total (цены не принимаются на веру),
    // строгие лимиты полей и привязка к транзакции счётчика counters/orders.
    function validPublicOrder(orderId) {
      return request.resource.data.status == 'new' && request.resource.data.number is int
        && request.resource.data.type in ['delivery', 'pickup', 'dinein']
        && getAfter(counterPath()).data.orderId == orderId
        && getAfter(counterPath()).data.value == request.resource.data.number
        && (request.resource.data.type == 'dinein' ? validDineinOrder() : validFulfillmentOrder());
    }
    // Заказ со стола: tableNumber 1..6, без телефона и адреса, имя и комментарий необязательны.
    function validDineinOrder() {
      return request.resource.data.keys().hasAll(['type', 'status', 'number', 'tableNumber'])
        && request.resource.data.keys().hasOnly(['type', 'status', 'number', 'tableNumber', 'name', 'comment', 'createdAt', 'source'])
        && request.resource.data.tableNumber is int && request.resource.data.tableNumber >= 1
        && request.resource.data.tableNumber <= 6
        && optionalString('name', 80) && optionalString('comment', 300)
        && validSource() && validCreatedAt();
    }
    // Геометка доставки: только ключи lat/lng с числами в допустимых диапазонах.
    function validOrderLocation() {
      return request.resource.data.location is map
        && request.resource.data.location.keys().hasOnly(['lat', 'lng'])
        && request.resource.data.location.lat is number && request.resource.data.location.lng is number
        && request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90
        && request.resource.data.location.lng >= -180 && request.resource.data.location.lng <= 180;
    }
    // Ссылка клиента на точку в картах: необязательная, https и не длиннее 300 символов.
    function validOrderMapLink() {
      return request.resource.data.mapLink is string && request.resource.data.mapLink.size() <= 300
        && request.resource.data.mapLink.matches('https://.*');
    }
    // Доставка/самовывоз: имя и телефон обязательны, адрес нужен для доставки, tableNumber запрещён.
    function validFulfillmentOrder() {
      return request.resource.data.keys().hasAll(['name', 'phone', 'type', 'status', 'number'])
        && request.resource.data.keys().hasOnly(['name', 'phone', 'type', 'status', 'number', 'address', 'comment', 'createdAt', 'source', 'location', 'mapLink', 'deliveryFee'])
        && requiredString('name', 2, 80) && requiredString('phone', 7, 20)
        && request.resource.data.type in ['delivery', 'pickup']
        && (request.resource.data.type == 'pickup' || requiredString('address', 5, 200))
        && optionalString('address', 200) && optionalString('comment', 300)
        && validSource() && validCreatedAt()
        && (!('deliveryFee' in request.resource.data) || (request.resource.data.type == 'delivery'
          && request.resource.data.deliveryFee is number && request.resource.data.deliveryFee >= 0
          && request.resource.data.deliveryFee <= 5000))
        && (!('location' in request.resource.data) || validOrderLocation())
        && (!('mapLink' in request.resource.data) || validOrderMapLink());
    }
    // Позиция заказа: цена и название сверяются с документом товара,
    // поэтому подменить цену через DevTools невозможно.
    function validPublicItem(itemId) {
      return request.resource.data.keys().hasOnly(['orderId', 'productId', 'productName', 'price', 'quantity'])
        && itemId == request.resource.data.orderId + '_' + request.resource.data.productId
        && request.resource.data.orderId is string && request.resource.data.productId is string
        && request.resource.data.productName is string && request.resource.data.price is number
        && request.resource.data.quantity is int && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 20
        && get(productPath(request.resource.data.productId)).data.inStock == true
        && request.resource.data.price == get(productPath(request.resource.data.productId)).data.price
        && request.resource.data.productName == get(productPath(request.resource.data.productId)).data.name
        && getAfter(orderPath(request.resource.data.orderId)).data.status == 'new'
        && getAfter(counterPath()).data.orderId == request.resource.data.orderId;
    }
    // Фото блюда — только ссылка: без data URL и не длиннее 500 символов.
    function validProductImage() {
      return request.resource.data.image is string && request.resource.data.image.size() <= 500
        && !request.resource.data.image.matches('data:.*');
    }
    // Витрина: меню и настройки читает любой, пишет только админ.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProductImage();
      allow delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    // Администраторы: документ создаётся только вручную через Firebase Console.
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validPublicOrder(orderId);
    }
    match /orderItems/{itemId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validPublicItem(itemId);
    }
    // Счётчик номеров заказов: публичное чтение, запись только вместе с заказом в транзакции.
    match /counters/orders {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['value', 'orderId'])
        && request.resource.data.value == 1001 && request.resource.data.orderId is string
        && !exists(orderPath(request.resource.data.orderId))
        && getAfter(orderPath(request.resource.data.orderId)).data.number == request.resource.data.value
        && getAfter(orderPath(request.resource.data.orderId)).data.status == 'new';
      allow update: if request.resource.data.keys().hasOnly(['value', 'orderId'])
        && request.resource.data.value == resource.data.value + 1 && request.resource.data.orderId is string
        && !exists(orderPath(request.resource.data.orderId))
        && getAfter(orderPath(request.resource.data.orderId)).data.number == request.resource.data.value
        && getAfter(orderPath(request.resource.data.orderId)).data.status == 'new';
    }
    // Всё остальное закрыто: для путей без явного правила доступа нет.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
