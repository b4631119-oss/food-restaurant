# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
/.freebuff/

# ключи и сертификаты
*.pem
*.key
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.pid
.qa-server.*

# env files
.env*
!.env.example

# service account keys (never commit)
service-account*.json
sa-key*.json

# внутренние артефакты аудита и QA — не для публичного репозитория
/audit/
/qa-screenshots/
*.bak
*backup*

# выгрузки и документы
*.pdf

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/AGENTS.md
/CLAUDE.md
